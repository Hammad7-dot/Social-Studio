# Social Studio environment configuration
# All values have safe dev defaults; the app never crashes if these are unset.

# 32-byte key, base64 or hex encoded (AES-256-GCM). Generate:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUta2V5LTMyLWJ5dGVzISE=

# Shared secret used to sign/verify delivery webhooks (HMAC-SHA256)
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Base URL of the mock platform server
MOCK_PLATFORM_URL=http://127.0.0.1:9000

# Base URL of this app, used by the mock platform for webhook callbacks
APP_BASE_URL=http://127.0.0.1:8000

# SQLite locations
DATABASE_URL=sqlite:///./data/social_studio.db
SCHEDULER_DB_URL=sqlite:///./data/scheduler.db

# Artifact output directory
ARTIFACTS_DIR=./artifacts

# HTTP client timeout (seconds) used when calling the mock platform
PUBLISH_TIMEOUT_SECONDS=5
PUBLISH_MAX_RETRIES=4
